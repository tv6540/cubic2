#!/bin/bash
# Quick display/audio reset. Installed to /usr/bin/x by the setup scripts.
# Detects outputs instead of hardcoding HDMI-1, so it works on the E6540 (HDMI),
# OptiPlex (DP/HDMI) and T450 (mini-DP / VGA) alike.

echo -e ">>>> Detecting displays"
INTERNAL_OUTPUT=$(xrandr 2>/dev/null | grep -E "^(eDP|LVDS)" | awk '{print $1}' | head -1)
EXTERNAL_OUTPUT=$(xrandr 2>/dev/null | grep " connected" | grep -vE "^(eDP|LVDS)" | awk '{print $1}' | head -1)
echo "Internal panel: ${INTERNAL_OUTPUT:-none}"
echo "External output: ${EXTERNAL_OUTPUT:-none}"

if [ -n "$EXTERNAL_OUTPUT" ]; then
  echo -e "\n>>>> Setting TV resolution on $EXTERNAL_OUTPUT"
  # Prefer the mode the setup script verified for this TV, then the usual candidates
  SAVED_MODE=$(cat /etc/cubic2-tv-mode 2>/dev/null)
  for mode in $SAVED_MODE 1600x900 1366x768 1920x1080; do
    if xrandr --output "$EXTERNAL_OUTPUT" --primary --mode "$mode" 2>/dev/null; then
      echo "Set $EXTERNAL_OUTPUT to $mode"
      SET_OK=1
      break
    fi
  done
  [ -n "$SET_OK" ] || xrandr --output "$EXTERNAL_OUTPUT" --primary --auto

  if [ -n "$INTERNAL_OUTPUT" ]; then
    echo -e "\n>>>> Disable internal monitor $INTERNAL_OUTPUT"
    xrandr --output "$INTERNAL_OUTPUT" --off
  fi
else
  echo "Warning: no external display connected"
fi

echo -e "\n>>>> Set screen timeout to never"
gsettings set org.gnome.desktop.session idle-delay 0

echo -e "\n>>>> Set HDMI/DP audio"
# Audio: GNOME Sound showed the working setup as
#   Output device:  "HDMI / DisplayPort - Built-in Audio"
#   Configuration:  "Digital Stereo (HDMI) Output"
# "Configuration" is the PipeWire card profile. Until a card is on an HDMI
# profile there is no HDMI sink at all, so switch the profile first, then pick
# the sink. Mini-DisplayPort audio on Intel shows up under the "hdmi" name.
set_hdmi_audio() {
  local sink card profile input

  sink=$(pactl list short sinks 2>/dev/null | grep -iE "hdmi|dp" | head -1 | awk '{print $2}')
  if [ -z "$sink" ]; then
    echo "No HDMI sink yet, switching card profile to Digital Stereo (HDMI) Output"
    local cards pick
    cards=$(pactl list cards 2>/dev/null || true)
    # Log cards and profiles so a failed run shows what PipeWire reported
    echo "$cards" | grep -E "^[[:space:]]+(Name:|output:)" | sed 's/^[[:space:]]*/    /' || true
    # Pick an HDMI output profile: prefer one marked "available: yes", else any.
    # Never use `read` here: with set -e an empty pipeline would abort the script.
    pick=$(echo "$cards" | awk '
      /^[ \t]+Name:/ {card=$2}
      /^[ \t]+output:[^ ]*hdmi/ && /sinks:/ {
        p=$1; sub(":$","",p)
        if ($0 ~ /available: yes/) { if (!a) a=card" "p } else { if (!b) b=card" "p }
      }
      END { print (a != "" ? a : b) }')
    card=${pick%% *}
    profile=${pick#* }
    if [ -n "$card" ] && [ -n "$profile" ] && [ "$card" != "$profile" ]; then
      echo "  $card -> $profile"
      pactl set-card-profile "$card" "$profile" 2>/dev/null || true
      sleep 2
      sink=$(pactl list short sinks 2>/dev/null | grep -iE "hdmi|dp" | head -1 | awk '{print $2}')
    else
      echo "  No HDMI profile found on any card"
    fi
  fi

  if [ -n "$sink" ]; then
    pactl set-default-sink "$sink"
    # Move anything already playing over to the TV
    for input in $(pactl list short sink-inputs 2>/dev/null | cut -f1); do
      pactl move-sink-input "$input" "$sink" 2>/dev/null || true
    done
    echo "Audio set to: $sink"
  else
    echo "Warning: no HDMI/DP audio sink found, using default"
  fi
}
set_hdmi_audio || echo "Warning: audio setup failed, continuing"

echo -e "\n>>>> Done"
